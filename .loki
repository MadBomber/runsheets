# frozen_string_literal: true
# runsheets — executable runbooks: markdown steps rendered in the browser, run and recorded.
#
# Asgard task file. The shared MadBomber gem tasks come from madbomber/dev,
# found by walking up from this directory (so no relative paths to keep):
#   gem_tasks.loki  console, build, install, release
#   quality.loki    quality (every *_check gate in parallel), test_check, rubocop_check, ...
#   git.loki        push, pull, fetch
#   doc_tasks.loki  doc_builder, doc_server (mkdocs.yml is present)
# Run `asgard help` for the full list.

require "shellwords"

import_up "dev/gem_tasks.loki"
import_up "dev/quality.loki"
import_up "dev/git.loki"
import_up "dev/doc_tasks.loki"

class Tasks
  @@gem_name ||= "runsheets".freeze

  header "runsheets v#{gem_version} — executable runbooks"

  desc "Run the test suite"
  def test
    sh "bundle exec rake test"
  end

  desc "Load every bundled example runbook and report authoring warnings"
  def check
    sh "bundle exec bin/runsheets --check examples"
  end

  desc "Ask what kind of runbook to make and write it into DIR (asked for when left out)"
  def new_runbook(dir = nil)
    sh "bundle exec bin/runsheets --new #{dir&.shellescape}".rstrip
  end
end
